{% comment %}
  Template: Producto
  Página de detalle del producto
{% endcomment %}

<div class="product-page">
  <div class="container">
    <div class="product-container">
      
      <!-- Galería de imágenes del producto -->
      <div class="product-gallery">
        <div class="main-image">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | img_url: '800x' }}" alt="{{ product.title }}" id="main-product-image">
          {% else %}
            <div class="no-image">Sin imagen disponible</div>
          {% endif %}
        </div>
        
        {% if product.images.size > 1 %}
          <div class="product-thumbnails">
            {% for image in product.images %}
              <img 
                src="{{ image | img_url: '100x' }}" 
                alt="{{ product.title }}"
                class="thumbnail {% if forloop.first %}active{% endif %}"
                onclick="changeMainImage('{{ image | img_url: '800x' }}')"
              >
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <!-- Información del producto -->
      <div class="product-info-section">
        <h1 class="product-title">{{ product.title }}</h1>
        
        <!-- Precio -->
        <div class="product-price-section">
          {% if product.compare_at_price > product.price %}
            <span class="price-sale">{{ product.price | money }}</span>
            <span class="price-compare">{{ product.compare_at_price | money }}</span>
            <span class="discount-badge">
              -{{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}%
            </span>
          {% else %}
            <span class="price-regular">{{ product.price | money }}</span>
          {% endif %}
        </div>

        <!-- Descripción -->
        <div class="product-description">
          {{ product.description }}
        </div>

        <!-- Formulario de agregar al carrito -->
        {% form 'product', product %}
          
          <!-- Variantes del producto -->
          {% unless product.has_only_default_variant %}
            <div class="product-variants">
              {% for option in product.options_with_values %}
                <div class="variant-option">
                  <label>{{ option.name }}</label>
                  <select name="options[{{ option.name }}]" class="variant-select">
                    {% for value in option.values %}
                      <option value="{{ value }}">{{ value }}</option>
                    {% endfor %}
                  </select>
                </div>
              {% endfor %}
            </div>
          {% endunless %}

          <!-- Selector de variante oculto -->
          <select name="id" id="ProductSelect" class="hidden">
            {% for variant in product.variants %}
              <option 
                value="{{ variant.id }}" 
                {% unless variant.available %}disabled{% endunless %}
              >
                {{ variant.title }} - {{ variant.price | money }}
              </option>
            {% endfor %}
          </select>

          <!-- Selector de cantidad -->
          <div class="quantity-selector">
            <label>Cantidad</label>
            <div class="quantity-input">
              <button type="button" class="qty-btn" onclick="decreaseQty()">-</button>
              <input type="number" name="quantity" value="1" min="1" id="quantity" readonly>
              <button type="button" class="qty-btn" onclick="increaseQty()">+</button>
            </div>
          </div>

          <!-- Botón de agregar al carrito -->
          <button 
            type="submit" 
            name="add" 
            class="add-to-cart-button"
            {% unless product.available %}disabled{% endunless %}
          >
            {% if product.available %}
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="9" cy="21" r="1"/>
                <circle cx="20" cy="21" r="1"/>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
              </svg>
              Agregar al Carrito
            {% else %}
              Agotado
            {% endif %}
          </button>

          <!-- Botón de comprar ahora (opcional) -->
          {% if product.available %}
            <button type="submit" name="checkout" class="buy-now-button">
              Comprar Ahora
            </button>
          {% endif %}

        {% endform %}

        <!-- Información adicional -->
        <div class="product-meta">
          {% if product.vendor %}
            <div class="meta-item">
              <strong>Marca:</strong> {{ product.vendor }}
            </div>
          {% endif %}
          {% if product.type %}
            <div class="meta-item">
              <strong>Categoría:</strong> {{ product.type }}
            </div>
          {% endif %}
          {% if product.available %}
            <div class="meta-item">
              <strong>Disponibilidad:</strong> <span class="in-stock">En stock</span>
            </div>
          {% else %}
            <div class="meta-item">
              <strong>Disponibilidad:</strong> <span class="out-of-stock">Agotado</span>
            </div>
          {% endif %}
        </div>

        <!-- Compartir en redes sociales -->
        <div class="product-share">
          <span>Compartir:</span>
          <a href="https://www.facebook.com/sharer.php?u={{ shop.url }}{{ product.url }}" target="_blank" class="share-btn">
            Facebook
          </a>
          <a href="https://twitter.com/share?url={{ shop.url }}{{ product.url }}&text={{ product.title }}" target="_blank" class="share-btn">
            Twitter
          </a>
          <a href="https://pinterest.com/pin/create/button/?url={{ shop.url }}{{ product.url }}&media={{ product.featured_image | img_url: 'large' }}&description={{ product.title }}" target="_blank" class="share-btn">
            Pinterest
          </a>
        </div>

      </div>
    </div>

    <!-- Productos relacionados -->
    {% if product.collections.first %}
      <div class="related-products">
        <h2 class="section-title">También te puede interesar</h2>
        <div class="products-grid">
          {% for related_product in product.collections.first.products limit: 4 %}
            {% unless related_product.id == product.id %}
              <div class="product-card">
                <a href="{{ related_product.url }}">
                  <div class="product-image">
                    {% if related_product.featured_image %}
                      <img src="{{ related_product.featured_image | img_url: '400x' }}" alt="{{ related_product.title }}">
                    {% endif %}
                  </div>
                  <div class="product-info">
                    <h3 class="product-title">{{ related_product.title }}</h3>
                    <div class="product-price">
                      <span class="price">{{ related_product.price | money }}</span>
                    </div>
                  </div>
                </a>
              </div>
            {% endunless %}
          {% endfor %}
        </div>
      </div>
    {% endif %}

  </div>
</div>

<script>
// Cambiar imagen principal
function changeMainImage(imageUrl) {
  document.getElementById('main-product-image').src = imageUrl;
  
  // Actualizar clase activa en thumbnails
  document.querySelectorAll('.thumbnail').forEach(thumb => {
    thumb.classList.remove('active');
  });
  event.target.classList.add('active');
}

// Aumentar cantidad
function increaseQty() {
  const qtyInput = document.getElementById('quantity');
  qtyInput.value = parseInt(qtyInput.value) + 1;
}

// Disminuir cantidad
function decreaseQty() {
  const qtyInput = document.getElementById('quantity');
  if (parseInt(qtyInput.value) > 1) {
    qtyInput.value = parseInt(qtyInput.value) - 1;
  }
}

// Manejar cambio de variantes
document.querySelectorAll('.variant-select').forEach(select => {
  select.addEventListener('change', updateVariant);
});

function updateVariant() {
  const selectedOptions = [];
  document.querySelectorAll('.variant-select').forEach(select => {
    selectedOptions.push(select.value);
  });
  
  const variantSelect = document.getElementById('ProductSelect');
  for (let option of variantSelect.options) {
    const variantTitle = option.text.split(' - ')[0];
    if (selectedOptions.every(opt => variantTitle.includes(opt))) {
      variantSelect.value = option.value;
      break;
    }
  }
}
</script>

<style>
.product-page {
  padding: 60px 0;
}

.product-container {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  margin-bottom: 80px;
}

.product-gallery .main-image {
  width: 100%;
  background: #f5f5f5;
  border-radius: 12px;
  overflow: hidden;
  margin-bottom: 20px;
}

.product-gallery .main-image img {
  width: 100%;
  height: auto;
  display: block;
}

.product-thumbnails {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.thumbnail {
  width: 80px;
  height: 80px;
  object-fit: cover;
  border-radius: 8px;
  cursor: pointer;
  border: 2px solid transparent;
  transition: all 0.3s;
}

.thumbnail:hover,
.thumbnail.active {
  border-color: #3498db;
}

.product-title {
  font-size: 2rem;
  margin-bottom: 20px;
  color: #2c3e50;
}

.product-price-section {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 20px;
  flex-wrap: wrap;
}

.price-regular,
.price-sale {
  font-size: 2rem;
  font-weight: 700;
  color: #2c3e50;
}

.price-compare {
  font-size: 1.5rem;
  color: #999;
  text-decoration: line-through;
}

.discount-badge {
  background: #e74c3c;
  color: white;
  padding: 5px 10px;
  border-radius: 4px;
  font-weight: 600;
  font-size: 0.9rem;
}

.product-description {
  margin-bottom: 30px;
  line-height: 1.8;
  color: #666;
}

.product-variants {
  margin-bottom: 25px;
}

.variant-option {
  margin-bottom: 15px;
}

.variant-option label {
  display: block;
  font-weight: 600;
  margin-bottom: 8px;
  color: #333;
}

.variant-select {
  width: 100%;
  padding: 12px;
  border: 1px solid #ddd;
  border-radius: 8px;
  font-size: 1rem;
  cursor: pointer;
}

.quantity-selector {
  margin-bottom: 25px;
}

.quantity-selector label {
  display: block;
  font-weight: 600;
  margin-bottom: 8px;
  color: #333;
}

.quantity-input {
  display: flex;
  align-items: center;
  gap: 10px;
  max-width: 150px;
}

.qty-btn {
  width: 40px;
  height: 40px;
  border: 1px solid #ddd;
  background: white;
  cursor: pointer;
  font-size: 1.2rem;
  border-radius: 4px;
  transition: all 0.3s;
}

.qty-btn:hover {
  background: #f5f5f5;
}

#quantity {
  width: 60px;
  text-align: center;
  border: 1px solid #ddd;
  padding: 10px;
  border-radius: 4px;
  font-size: 1rem;
}

.add-to-cart-button,
.buy-now-button {
  width: 100%;
  padding: 15px 30px;
  font-size: 1.1rem;
  font-weight: 600;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.3s;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin-bottom: 15px;
}

.add-to-cart-button {
  background: #2c3e50;
  color: white;
}

.add-to-cart-button:hover:not(:disabled) {
  background: #1a252f;
  transform: translateY(-2px);
}

.add-to-cart-button:disabled {
  background: #ccc;
  cursor: not-allowed;
}

.buy-now-button {
  background: #3498db;
  color: white;
}

.buy-now-button:hover {
  background: #2980b9;
}

.product-meta {
  margin: 30px 0;
  padding: 20px 0;
  border-top: 1px solid #eee;
  border-bottom: 1px solid #eee;
}

.meta-item {
  margin-bottom: 10px;
  color: #666;
}

.in-stock {
  color: #27ae60;
  font-weight: 600;
}

.out-of-stock {
  color: #e74c3c;
  font-weight: 600;
}

.product-share {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.share-btn {
  padding: 8px 15px;
  background: #f5f5f5;
  border-radius: 4px;
  text-decoration: none;
  color: #333;
  font-size: 0.9rem;
  transition: all 0.3s;
}

.share-btn:hover {
  background: #3498db;
  color: white;
}

.related-products {
  margin-top: 80px;
}

.hidden {
  display: none;
}

@media (max-width: 768px) {
  .product-container {
    grid-template-columns: 1fr;
    gap: 30px;
  }
  
  .product-title {
    font-size: 1.5rem;
  }
  
  .price-regular,
  .price-sale {
    font-size: 1.5rem;
  }
}
</style>
