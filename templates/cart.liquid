{% comment %}
  Template: Carrito de Compras
{% endcomment %}

<div class="cart-page">
  <div class="container">
    <h1>Carrito de Compras</h1>

    {% if cart.item_count > 0 %}
      <div class="cart-content">
        <div class="cart-items">
          <form action="/cart" method="post" id="cart-form">
            {% for item in cart.items %}
              <div class="cart-item" data-line="{{ forloop.index }}">
                <div class="item-image">
                  <a href="{{ item.url }}">
                    <img src="{{ item.image | img_url: '200x' }}" alt="{{ item.title }}">
                  </a>
                </div>

                <div class="item-details">
                  <h3 class="item-title">
                    <a href="{{ item.url }}">{{ item.product.title }}</a>
                  </h3>
                  {% unless item.variant.title == 'Default Title' %}
                    <p class="item-variant">{{ item.variant.title }}</p>
                  {% endunless %}
                  {% if item.properties %}
                    {% for property in item.properties %}
                      <p class="item-property">{{ property.first }}: {{ property.last }}</p>
                    {% endfor %}
                  {% endif %}
                </div>

                <div class="item-price">
                  <span class="price">{{ item.price | money }}</span>
                </div>

                <div class="item-quantity">
                  <div class="quantity-controls">
                    <button type="button" class="qty-btn" onclick="updateQuantity({{ forloop.index }}, -1)">-</button>
                    <input 
                      type="number" 
                      name="updates[]" 
                      id="updates_{{ forloop.index }}" 
                      value="{{ item.quantity }}" 
                      min="0"
                      class="quantity-input"
                      onchange="updateCart()"
                    >
                    <button type="button" class="qty-btn" onclick="updateQuantity({{ forloop.index }}, 1)">+</button>
                  </div>
                </div>

                <div class="item-total">
                  <span class="price">{{ item.line_price | money }}</span>
                </div>

                <div class="item-remove">
                  <button type="button" class="remove-btn" onclick="removeItem({{ forloop.index }})">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                      <line x1="18" y1="6" x2="6" y2="18"></line>
                      <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                  </button>
                </div>
              </div>
            {% endfor %}
          </form>
        </div>

        <div class="cart-summary">
          <h2>Resumen del Pedido</h2>
          
          <div class="summary-line">
            <span>Subtotal</span>
            <span class="price">{{ cart.total_price | money }}</span>
          </div>

          <div class="summary-line">
            <span>Envío</span>
            <span>Calculado en el checkout</span>
          </div>

          <div class="summary-total">
            <span>Total</span>
            <span class="price">{{ cart.total_price | money }}</span>
          </div>

          <form action="/cart" method="post" class="cart-note">
            <label for="note">Nota del pedido (opcional)</label>
            <textarea name="note" id="note" rows="3">{{ cart.note }}</textarea>
            <button type="submit" class="update-note-btn">Actualizar nota</button>
          </form>

          <button type="submit" name="checkout" class="checkout-btn" onclick="window.location.href='/checkout'">
            Proceder al Pago
          </button>

          <a href="/collections/all" class="continue-shopping">← Continuar comprando</a>
        </div>
      </div>
    {% else %}
      <div class="empty-cart">
        <svg width="100" height="100" viewBox="0 0 24 24" fill="none" stroke="#ccc" stroke-width="2">
          <circle cx="9" cy="21" r="1"/>
          <circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        <h2>Tu carrito está vacío</h2>
        <p>Agrega productos para comenzar tu compra</p>
        <a href="/collections/all" class="btn-primary">Ver Productos</a>
      </div>
    {% endif %}
  </div>
</div>

<style>
.cart-page {
  padding: 60px 0;
  min-height: 60vh;
}

.cart-page h1 {
  font-size: 2.5rem;
  margin-bottom: 40px;
  color: #2c3e50;
  text-align: center;
}

.cart-content {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 40px;
}

.cart-items {
  background: white;
  border-radius: 12px;
  padding: 20px;
}

.cart-item {
  display: grid;
  grid-template-columns: 100px 2fr 1fr 120px 1fr 40px;
  gap: 20px;
  align-items: center;
  padding: 20px;
  border-bottom: 1px solid #e0e0e0;
}

.cart-item:last-child {
  border-bottom: none;
}

.item-image img {
  width: 100%;
  border-radius: 8px;
}

.item-title {
  font-size: 1.1rem;
  margin-bottom: 5px;
}

.item-title a {
  color: #2c3e50;
  text-decoration: none;
}

.item-title a:hover {
  color: #3498db;
}

.item-variant,
.item-property {
  font-size: 0.9rem;
  color: #666;
  margin: 3px 0;
}

.item-price .price {
  font-weight: 600;
  color: #2c3e50;
}

.quantity-controls {
  display: flex;
  border: 2px solid #ddd;
  border-radius: 8px;
  overflow: hidden;
  width: 120px;
}

.qty-btn {
  width: 35px;
  background: white;
  border: none;
  cursor: pointer;
  font-size: 1.2rem;
  font-weight: 600;
  color: #2c3e50;
  transition: background 0.3s;
}

.qty-btn:hover {
  background: #f0f0f0;
}

.quantity-input {
  flex: 1;
  border: none;
  text-align: center;
  font-weight: 600;
  -moz-appearance: textfield;
}

.quantity-input::-webkit-outer-spin-button,
.quantity-input::-webkit-inner-spin-button {
  -webkit-appearance: none;
}

.item-total .price {
  font-size: 1.1rem;
  font-weight: 700;
  color: #2c3e50;
}

.remove-btn {
  background: none;
  border: none;
  cursor: pointer;
  color: #e74c3c;
  padding: 5px;
  transition: transform 0.3s;
}

.remove-btn:hover {
  transform: scale(1.2);
}

.cart-summary {
  background: #f9f9f9;
  border-radius: 12px;
  padding: 30px;
  height: fit-content;
  position: sticky;
  top: 100px;
}

.cart-summary h2 {
  font-size: 1.5rem;
  margin-bottom: 20px;
  color: #2c3e50;
}

.summary-line {
  display: flex;
  justify-content: space-between;
  margin-bottom: 15px;
  color: #666;
}

.summary-total {
  display: flex;
  justify-content: space-between;
  margin: 25px 0;
  padding-top: 20px;
  border-top: 2px solid #ddd;
  font-size: 1.3rem;
  font-weight: 700;
  color: #2c3e50;
}

.cart-note {
  margin: 20px 0;
}

.cart-note label {
  display: block;
  margin-bottom: 8px;
  font-weight: 600;
  color: #2c3e50;
}

.cart-note textarea {
  width: 100%;
  padding: 10px;
  border: 2px solid #ddd;
  border-radius: 8px;
  resize: vertical;
  font-family: inherit;
}

.update-note-btn {
  margin-top: 10px;
  padding: 8px 15px;
  background: #95a5a6;
  color: white;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  font-size: 0.9rem;
}

.checkout-btn {
  width: 100%;
  padding: 18px;
  background: #27ae60;
  color: white;
  border: none;
  border-radius: 8px;
  font-size: 1.1rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s;
  margin-bottom: 15px;
}

.checkout-btn:hover {
  background: #229954;
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(39, 174, 96, 0.3);
}

.continue-shopping {
  display: block;
  text-align: center;
  color: #3498db;
  text-decoration: none;
  font-weight: 600;
  padding: 10px;
}

.continue-shopping:hover {
  text-decoration: underline;
}

.empty-cart {
  text-align: center;
  padding: 80px 20px;
}

.empty-cart svg {
  margin-bottom: 30px;
}

.empty-cart h2 {
  font-size: 2rem;
  margin-bottom: 15px;
  color: #2c3e50;
}

.empty-cart p {
  color: #666;
  margin-bottom: 30px;
}

.btn-primary {
  display: inline-block;
  padding: 15px 40px;
  background: #2c3e50;
  color: white;
  text-decoration: none;
  border-radius: 8px;
  font-weight: 600;
  transition: all 0.3s;
}

.btn-primary:hover {
  background: #1a252f;
  transform: translateY(-2px);
}

@media (max-width: 968px) {
  .cart-content {
    grid-template-columns: 1fr;
  }

  .cart-summary {
    position: static;
  }

  .cart-item {
    grid-template-columns: 80px 1fr;
    gap: 15px;
  }

  .item-price,
  .item-quantity,
  .item-total {
    grid-column: 2;
  }

  .item-remove {
    grid-column: 2;
    text-align: right;
  }
}
</style>

<script>
function updateQuantity(line, change) {
  const input = document.getElementById('updates_' + line);
  const newValue = Math.max(0, parseInt(input.value) + change);
  input.value = newValue;
  updateCart();
}

function updateCart() {
  document.getElementById('cart-form').submit();
}

function removeItem(line) {
  const input = document.getElementById('updates_' + line);
  input.value = 0;
  updateCart();
}
</script>
