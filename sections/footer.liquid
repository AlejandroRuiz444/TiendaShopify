{% comment %}
  Sección: Footer
  Pie de página del sitio
{% endcomment %}

<footer class="site-footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-column">
        <h3>{{ shop.name }}</h3>
        <p>{{ section.settings.footer_description | default: "Tu tienda de confianza" }}</p>
      </div>
      
      <div class="footer-column">
        <h4>{{ section.settings.menu_title_1 | default: "Enlaces rápidos" }}</h4>
        <ul>
          {% for link in linklists[section.settings.footer_menu_1].links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </div>
      
      <div class="footer-column">
        <h4>{{ section.settings.contact_title | default: "Contacto" }}</h4>
        <ul>
          {% if shop.email %}
            <li><a href="mailto:{{ shop.email }}">{{ shop.email }}</a></li>
          {% endif %}
          {% if section.settings.phone_number %}
            <li>{{ section.settings.phone_number }}</li>
          {% endif %}
          {% if section.settings.address %}
            <li>{{ section.settings.address }}</li>
          {% endif %}
        </ul>
      </div>
      
      <div class="footer-column">
        <h4>{{ section.settings.social_title | default: "Síguenos" }}</h4>
        <div class="social-links">
          {% if section.settings.social_facebook_link != blank %}
            <a href="{{ section.settings.social_facebook_link }}" target="_blank" rel="noopener">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
              Facebook
            </a>
          {% endif %}
          {% if section.settings.social_instagram_link != blank %}
            <a href="{{ section.settings.social_instagram_link }}" target="_blank" rel="noopener">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
              Instagram
            </a>
          {% endif %}
          {% if section.settings.social_twitter_link != blank %}
            <a href="{{ section.settings.social_twitter_link }}" target="_blank" rel="noopener">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
              </svg>
              Twitter
            </a>
          {% endif %}
          {% if section.settings.social_youtube_link != blank %}
            <a href="{{ section.settings.social_youtube_link }}" target="_blank" rel="noopener">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
              YouTube
            </a>
          {% endif %}
        </div>
      </div>
    </div>
    
    <div class="footer-bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_text | default: "Todos los derechos reservados." }}</p>
      {% if section.settings.show_powered_by %}
        <p>Powered by Shopify</p>
      {% endif %}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Descripción"
    },
    {
      "type": "textarea",
      "id": "footer_description",
      "label": "Descripción del footer",
      "default": "Tu tienda de confianza"
    },
    {
      "type": "header",
      "content": "Menú 1"
    },
    {
      "type": "text",
      "id": "menu_title_1",
      "label": "Título del menú",
      "default": "Enlaces rápidos"
    },
    {
      "type": "link_list",
      "id": "footer_menu_1",
      "label": "Menú",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "Contacto"
    },
    {
      "type": "text",
      "id": "contact_title",
      "label": "Título de contacto",
      "default": "Contacto"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Número de teléfono"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Dirección"
    },
    {
      "type": "header",
      "content": "Redes Sociales"
    },
    {
      "type": "text",
      "id": "social_title",
      "label": "Título de redes sociales",
      "default": "Síguenos"
    },
    {
      "type": "url",
      "id": "social_facebook_link",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_instagram_link",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_twitter_link",
      "label": "Twitter URL"
    },
    {
      "type": "url",
      "id": "social_youtube_link",
      "label": "YouTube URL"
    },
    {
      "type": "header",
      "content": "Copyright"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Texto de copyright",
      "default": "Todos los derechos reservados."
    },
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "Mostrar 'Powered by Shopify'",
      "default": true
    }
  ]
}
{% endschema %}

{% stylesheet %}
.site-footer {
  background: #2c3e50;
  color: white;
  padding: 60px 0 20px;
  margin-top: 80px;
}

.footer-content {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 40px;
  margin-bottom: 40px;
}

.footer-column h3, .footer-column h4 {
  margin-bottom: 20px;
  color: white;
  font-size: 1.2rem;
}

.footer-column p {
  line-height: 1.6;
  opacity: 0.9;
}

.footer-column ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.footer-column ul li {
  margin-bottom: 10px;
}

.footer-column a {
  color: rgba(255,255,255,0.8);
  transition: color 0.3s;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.footer-column a:hover {
  color: white;
}

.social-links {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.social-links svg {
  width: 20px;
  height: 20px;
}

.footer-bottom {
  text-align: center;
  padding-top: 20px;
  border-top: 1px solid rgba(255,255,255,0.1);
  color: rgba(255,255,255,0.6);
}

.footer-bottom p {
  margin: 5px 0;
  font-size: 0.9rem;
}

@media (max-width: 768px) {
  .footer-content {
    grid-template-columns: 1fr;
    gap: 30px;
  }
  
  .site-footer {
    padding: 40px 0 20px;
    margin-top: 60px;
  }
}
{% endstylesheet %}
